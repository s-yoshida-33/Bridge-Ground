{
    "name": "bridge-ground",
    "version": "1.0.1",
    "description": "A data synchronization and REST API proxy application for Mall data.",
    "main": "src/main.js",
    "scripts": {
        "start": "electron src/main.js",
        "build": "electron-builder --win",
        "postinstall": "electron-builder install-app-deps",
        "icon:gen": "magick -background none -density 1024 src/assets/icon.svg -define icon:auto-resize=256,128,64,48,32,16 src/assets/icon.ico"
    },
    "keywords": [
        "data-sync",
        "rest-api",
        "proxy",
        "cross-platform"
    ],
    "author": "Toei Techno International Inc.",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.6.8",
        "better-sqlite3": "^12.5.0",
        "crypto": "^1.0.1",
        "express": "^4.19.2",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.13.0",
        "electron-rebuild": "^3.2.9"
    },
    "build": {
        "appId": "com.tti.bridgeground",
        "productName": "BridgeGround",
        "copyright": "Copyright © 2024 Toei Techno International Inc.",
        "files": [
            "src/**/*",
            "package.json"
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "icon": "src/assets/icon.ico",
            "target": "nsis"
        },
        "mac": {
            "icon": "src/assets/icon.icns"
        },
        "linux": {
            "icon": "src/assets/icon.png"
        }
    }
}
