{
    "name": "bridge-ground",
    "version": "1.0.0",
    "description": "A data synchronization and REST API proxy application for Mall data.",
    "main": "src/main.js",
    "scripts": {
        "start": "electron src/main.js",
        "build": "electron-builder --linux --win",
        "postinstall": "electron-builder install-app-deps"
    },
    "keywords": [
        "data-sync",
        "rest-api",
        "proxy",
        "cross-platform"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.6.8",
        "crypto": "^1.0.1",
        "electron": "^28.0.0",
        "express": "^4.19.2",
        "sqlite3": "^5.1.7",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "electron-builder": "^24.13.0",
        "electron-rebuild": "^3.2.9"
    },
    "build": {
        "appId": "com.tti.bridgeground",
        "productName": "BridgeGround",
        "files": [
            "src/**/*",
            "package.json"
        ],
        "directories": {
            "output": "dist"
        }
    }
}
